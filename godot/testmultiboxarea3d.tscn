[sub_resource type="GDScript" id="GDScript_3uncl"]
resource_name = "turn"
script/source = "extends RayCast3D

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	var m = get_viewport().get_mouse_position().x
	var width = get_viewport().get_window().size[0]
	var f = m / width
	rotation.y = f * 2 * PI
	
	
"

