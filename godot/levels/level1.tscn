[sub_resource type="GDScript" id="GDScript_5j4jy"]
resource_name = "bridge"
script/source = "@tool
extends Node3D

@export var tween_time: float = 1
@export var target: Node3D
var starting_transform: Transform3D
var target_transform: Transform3D

@export_range(0, 1, 0.01) var test_weight: float:
	set(value):
		if test_weight == 0 \\
			and target != null and Engine.is_editor_hint():
			target_transform = target.global_transform
			starting_transform = global_transform
		interpolate(value)
		test_weight = value

func _ready():
	starting_transform = global_transform
	if target != null:
		target_transform = target.global_transform

func connect_bridge():
	if target == null:
		return
	create_tween().tween_method(interpolate, 0., 1., tween_time)

func disconnect_bridge():
	if target == null:
		return
	create_tween().tween_method(interpolate, 1., 0., tween_time)


func interpolate(weight: float):
	global_basis = starting_transform.basis.slerp(target_transform.basis, weight)
	global_position = starting_transform.origin.lerp(target_transform.origin, weight)


func _notification(what: int) -> void:
	match what:
		NOTIFICATION_EDITOR_PRE_SAVE:
			if test_weight > 0:
				test_weight = 0
"

