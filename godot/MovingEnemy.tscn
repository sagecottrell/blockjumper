[sub_resource type="GDScript" id="GDScript_wukpf"]
script/source = "@tool
extends Node3D

signal ready_to_move()
signal started_moving()
signal stopped_moving()
signal _move_or_fail(which_one: String)

## s - straight 1 unit, S - straight until cannot move anymore, 
## L - turn left until facing a valid position (includes 1 unit move), 
## R - turn right until facing a valid position (includes 1 unit move)
@export var command: String = \"s\":
	set(value):
		command = \"\".join(Array(value.split()).map(_map_char).filter(_valid_char))

func _map_char(c: String):
	match c:
		\"l\":
			return \"L\"
		\"r\":
			return \"R\"
		\"s\", \"S\", \"L\", \"R\":
			return c
	return null
	
func _valid_char(c):
	match c:
		\"s\", \"S\", \"L\", \"R\":
			return true
	return false

var step: int = -1

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	if Engine.is_editor_hint():
		return
	increment_state()
	
	var fail = func(): 
		_move_or_fail.emit(\"fail\")
	var move = func():
		_move_or_fail.emit(\"move\")
		
	$TargetSelector.target_select_failed.connect(fail)
	$MovementHandler.completed_moving.connect(move)

func on_stop_moving():
	stopped_moving.emit()

func on_start_moving():
	started_moving.emit()

func increment_state():
	step += 1
	if step >= command.length():
		step = 0
	
	match command[step]:
		\"s\":
			state_move_one()
		\"S\":
			state_move_many()
		\"L\":
			state_turn_left()
		\"R\":
			state_turn_right()

## attempt to move forward 1 unit
func state_move_one():
	ready_to_move.emit.call_deferred()
	await _move_or_fail
	increment_state()

func state_move_many():
	while true:
		ready_to_move.emit.call_deferred()
		match await _move_or_fail:
			\"fail\":
				return increment_state()
		

func state_turn_left():
	var rotations := 0
	while rotations < 4:
		rotations += 1
		rotate_y(PI / 2)
		ready_to_move.emit.call_deferred()
		match await _move_or_fail:
			\"move\":
				return increment_state()
		

func state_turn_right():
	var rotations := 0
	while rotations < 4:
		rotations += 1
		rotate_y(-PI / 2)
		ready_to_move.emit.call_deferred()
		match await _move_or_fail:
			\"move\":
				return increment_state()
"

