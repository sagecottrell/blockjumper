[gd_scene format=3 uid="uid://dt0r2ym10casc"]

[ext_resource type="PackedScene" uid="uid://dsr4lhpojxf84" path="res://models/spiketrap/spiketrap.gltf" id="1_85myt"]

[sub_resource type="GDScript" id="GDScript_5j4jy"]
resource_name = "spiketrap"
script/source = "@tool
extends Node3D

@export_range(0, 10) var start_delay: float = 0:
	set(value):
		var s := start_delay
		start_delay = value
		if !is_inside_tree():
			return
		if value < s:
			_start_delay(trap_every - s + value)
		elif value > s:
			_start_delay(value - s)
	
@export_range(3, 20) var trap_every: float = 3:
	set(value):
		if is_inside_tree():
			var mintime := tele_2_act.wait_time + act_2_deac.wait_time + 2
			trap_every = max(value, mintime)
			deac_2_tele.wait_time = trap_every - mintime
		else:
			trap_every = value
		
@onready var tele_2_act: Timer = $tele2act
@onready var act_2_deac: Timer = $act2deac
@onready var deac_2_tele: Timer = $deac2tele
@onready var blockbench_export: GLTFImport = $blockbench_export
@onready var area_3d: Area3D = %EnemyHurtbox

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	tele_2_act.timeout.connect(_act)
	act_2_deac.timeout.connect(_deac)
	deac_2_tele.timeout.connect(_tele)
	
	deac_2_tele.wait_time = trap_every
	deac_2_tele.start()

func _start_delay(delay: float):
	pause()
	await get_tree().create_timer(delay).timeout
	start()

func _act():
	area_3d.process_mode = Node.PROCESS_MODE_INHERIT
	act_2_deac.start()
	blockbench_export.play_animation_with_length(\"activate\", 0.1)

func _deac():
	area_3d.process_mode = Node.PROCESS_MODE_DISABLED
	deac_2_tele.start()
	blockbench_export.play_animation(\"deactivate\")
	
func _tele():
	area_3d.process_mode = Node.PROCESS_MODE_DISABLED
	tele_2_act.start()
	blockbench_export.play_animation_with_length(\"telegraph\", 0.1)

func pause():
	tele_2_act.paused = true
	act_2_deac.paused = true
	deac_2_tele.paused = true

func start():
	tele_2_act.paused = false
	act_2_deac.paused = false
	deac_2_tele.paused = false
"

